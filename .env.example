# API (apps/api)
NODE_ENV=development
PORT=4000
# Local: pglite://./.data/pg   Production: postgres://user:pass@host:5432/webdizayn
DATABASE_URL=pglite://./.data/pg
WEB_ORIGINS=http://localhost:3000
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
DEFAULT_ORG_SLUG=webdizayn
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
# Proxies allowed to set X-Forwarded-For (the browser reaches the API through Next.js).
# Production: list the Next.js host(s) and put an edge proxy in front of Next.js that
# OVERWRITES X-Forwarded-For with the real client IP. Values: false | <hops> | names/IPs/CIDRs.
TRUST_PROXY=loopback
REGISTER_MAX_PER_HOUR=10
PUBLIC_RATE_PER_MINUTE=120
# CHECK engine (server-side Playwright, apps/api + packages/check-engine)
# process: headless Chrome in a killable child process. disabled: every CHECK reports ERROR.
CHECK_ENGINE=process
# Empty: the installed Google Chrome. Otherwise a Chrome/Chromium executable path.
CHECK_CHROME_PATH=
# Keep the renderer sandbox on; only set false where the OS cannot provide it.
CHECK_CHROMIUM_SANDBOX=true
CHECK_CONCURRENCY=2
CHECK_BUDGET_MS=20000
# Max CHECK runs per user per 10 minutes
CHECK_RATE_LIMIT=20
# AI tutor. Default is the offline mock. A real provider is used only when AI_PROVIDER=http,
# AI_ALLOW_REAL_STUDENT_DATA=true (DPA / data location approved), URL and key are all set.
AI_PROVIDER=mock
# Full OpenAI-compatible chat-completions URL (https required in production)
AI_PROVIDER_URL=
AI_PROVIDER_MODEL=tutor
# Secret: never commit; sent only in the Authorization header
AI_PROVIDER_API_KEY=
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_ATTEMPTS=2
AI_DAILY_REQUESTS=40
AI_DAILY_PROMPT_CHARS=150000
AI_RATE_PER_MINUTE=6
AI_ALLOW_REAL_STUDENT_DATA=false
AI_COST_PER_1K_CHARS_MICROUSD=0

# Only for `pnpm --filter @webdizayn/api db:seed` (local dev)
SEED_PASSWORD=

# Web (apps/web)
API_URL=http://localhost:4000

# Sandbox (apps/sandbox) — must be a different *site* from the web app.
# Local: 127.0.0.1 vs localhost. Production: a separate registrable domain
# (e.g. https://webdizayn-usercontent.uz), not a subdomain of the web app.
SANDBOX_HOST=127.0.0.1
SANDBOX_PORT=3100
SANDBOX_PARENT_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SANDBOX_URL=http://127.0.0.1:3100
